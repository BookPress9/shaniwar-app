{
  "expo": {
    "name": "Shaniwar: Living Dincharya",
    "slug": "shaniwar",
    "version": "1.0.0",
    "scheme": "shaniwar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#070807",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shaniwar.app",
      "buildNumber": "1",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "NSCameraUsageDescription": "Shaniwar uses the camera for waking action missions to verify wakefulness without cloud upload.",
        "NSMotionUsageDescription": "Shaniwar uses motion sensors to detect genuine ambulatory steps for the morning action alarm.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.shaniwar.app",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "HIGH_SAMPLING_RATE_SENSORS",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#070807",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Shaniwar uses motion sensors to detect genuine ambulatory steps for the morning action alarm."
        }
      ],
      "expo-status-bar"
    ]
  }
}
